<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/overlay_card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_mihrab_card_bg"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@drawable/overlay_mihrab_inner_border"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Unboxed Metadata Header: Type · Source -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlay_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="آية قرآنية"
                    android:textColor="#F3D078"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="·"
                    android:textColor="#D4AF37"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/overlay_source_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="سورة الرعد • الآية ٢٨"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Compact Verse / Hadith / Wisdom Quote -->
            <TextView
                android:id="@+id/overlay_quote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:gravity="start"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:text="﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Action Row: Next & Dismiss Only -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlay_btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/overlay_btn_primary_bg"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="التالي"
                    android:textColor="#F3D078"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_btn_dismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/overlay_btn_secondary_bg"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="إغلاق"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Thin Auto-Close Progress Hairline -->
            <ProgressBar
                android:id="@+id/overlay_countdown_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:max="15000"
                android:progress="15000"
                android:progressDrawable="@drawable/overlay_progress_drawable" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

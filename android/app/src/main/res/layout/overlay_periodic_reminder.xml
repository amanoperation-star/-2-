<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="18dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/overlay_card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/overlay_mihrab_card_bg"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/overlay_mihrab_inner_border"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="14dp">

            <!-- Top Row: Close Button & Reminder Type Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/overlay_btn_close_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/overlay_btn_secondary_bg"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#E5B869"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="✦  آية قرآنية كريمة  ✦"
                    android:textColor="#E5B869"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Main Verse / Hadith Quote -->
            <TextView
                android:id="@+id/overlay_quote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:maxLines="6"
                android:text="﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Source Citation -->
            <TextView
                android:id="@+id/overlay_source_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="سورة الرعد • الآية ٢٨"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Short Reflection -->
            <TextView
                android:id="@+id/overlay_reflection_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:text=""
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- 15-Second Countdown Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="يُغلق تلقائياً خلال"
                        android:textColor="#E5B869"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/overlay_countdown_seconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="monospace"
                        android:text="15 ث"
                        android:textColor="#FBBF24"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/overlay_countdown_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="15000"
                    android:progress="15000"
                    android:progressDrawable="@drawable/overlay_progress_drawable" />
            </LinearLayout>

            <!-- Action Row (44dp+ touch targets) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/overlay_btn_next"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/overlay_btn_primary_bg"
                    android:gravity="center"
                    android:text="التالي"
                    android:textColor="#FBBF24"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_btn_copy"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/overlay_btn_secondary_bg"
                    android:gravity="center"
                    android:text="نسخ النص"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_btn_dismiss"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/overlay_btn_secondary_bg"
                    android:gravity="center"
                    android:text="إغلاق"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Hanging Lantern Badge at Mihrab Apex -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/overlay_lantern_badge_bg"
        android:elevation="16dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lantern_glow" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#FF02100D" />
            <corners android:radius="6dp" />
            <stroke
                android:width="0.6dp"
                android:color="#33E5B869" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#FF10B981"
                    android:centerColor="#FFE5B869"
                    android:endColor="#FFFBBF24"
                    android:type="linear" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
